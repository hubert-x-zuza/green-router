<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>pl.zdrowatrasa.air</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>etl.air</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- every hour at minute 7; launchd runs a missed job once after the Mac wakes -->
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>7</integer></dict>
  <key>StandardOutPath</key><string>__REPO__/logs/air.log</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/air.log</string>
</dict>
</plist>
